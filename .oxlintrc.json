{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["unicorn", "typescript", "oxc", "vitest", "vue"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"rules": {
		"no-console": "warn",
		"no-await-in-loop": "off",
		"unicorn/no-array-sort": "off",
		"no-restricted-globals": "error",
		"typescript/consistent-type-imports": "error"
	},
	"ignorePatterns": [
		".output/**",
		".nuxt/**",
		".nitro/**",
		".cache/**",
		".agents/**",
		"public/**",
		".data/**",
		"dist/**",
		"node_modules/**",
		"coverage/**",
		"playwright-report/**",
		"test-results/**",
		"bun.lock"
	]
}
